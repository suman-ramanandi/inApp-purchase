# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only placeholder. Never put real credentials in this file.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Must match the POSTGRES_* values below (user, password, port, database). They are kept
# separate because the API also connects to databases that are not this Compose service.
DATABASE_URL=postgres://inapp:local-dev-only@localhost:5432/inapp

# --- Local PostgreSQL (docker compose) ---
POSTGRES_USER=inapp
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=inapp
POSTGRES_PORT=5432
